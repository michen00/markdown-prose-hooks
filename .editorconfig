root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
# shfmt-only keys, under [*] so they reach shell scripts without an extension.
simplify = true
space_redirects = true
switch_case_indent = true

[*.py]
indent_size = 4
indent_style = space
max_line_length = 88

[*.rs]
indent_size = 4
indent_style = space
max_line_length = 100

[*.sh]
indent_size = 2
indent_style = space

[*.{json,jsonc,md}]
indent_size = 2
indent_style = space

[*.toml]
indent_size = 2
indent_style = space

[*.{yaml,yml}]
indent_size = 2
indent_style = space
max_line_length = 100

[Makefile]
indent_style = tab

# Corpus fixtures pin trailing spaces, CRLF, a BOM, non-UTF-8 and no final newline.
[corpus/*/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
