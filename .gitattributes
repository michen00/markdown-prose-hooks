# List any file patterns that are text and should have line endings
# normalized, i.e. convert crlf => lf
.codespellrc            text eol=lf
.editorconfig           text eol=lf
.git-blame-ignore-revs  text eol=lf
.gitattributes          text eol=lf
.gitignore              text eol=lf
.gitlint                text eol=lf
.markdownlintignore     text eol=lf
.prettierignore         text eol=lf
.prettierrc             text eol=lf
.unwrapignore           text eol=lf
.yamllint               text eol=lf diff=yaml
*.in                    text eol=lf
*.ipynb                 text eol=lf
*.json                  text eol=lf
*.jsonc                 text eol=lf
*.lock                  text eol=lf
*.md                    text eol=lf diff=markdown
*.py                    text eol=lf diff=python
*.rs                    text eol=lf diff=rust
*.sh                    text eol=lf diff=bash
*.svg                   text eol=lf
*.toml                  text eol=lf
*.txt                   text eol=lf
*.yaml                  text eol=lf
*.yml                   text eol=lf
LICENSE                 text eol=lf
Makefile                text eol=lf
mirrors/rs/gitignore    text eol=lf

# No PNG is tracked. The rule stays because pyproject.toml and both notebooks
# give it as the reason their charts are SVG rather than PNG.
*.png  filter=lfs diff=lfs merge=lfs -text

.gitignore               linguist-generated=true
Cargo.lock               linguist-generated=true
docs/notebooks/**/*.svg  linguist-generated=true
uv.lock                  linguist-generated=true

# The transform tier's fixtures are bytes, not text, and several pin CRLF.
corpus/cases/**/*.md -text -diff

# The CLI tier for the same reason, widened from `*.md` to the whole subtree:
# its `case.txt` and `stdout.txt` are asserted byte for byte alongside the
# fixtures, and a case pinning CRLF stops pinning anything once git normalizes
# it on checkout.
corpus/cli/** -text -diff
